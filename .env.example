# Copy to .env and fill in. (.env is git-ignored)
PORT=3001

# Auth0 tenant domain (no https://), same as the SPA's domain
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier of the "Pizza 42 API" in Auth0. Must match exactly, no trailing slash.
AUTH0_AUDIENCE=https://api.pizza42.example.com

# Where the Angular app runs (CORS)
ALLOWED_ORIGIN=http://localhost:4200

# Must match claimsNamespace in the Angular app / Auth0 Actions
CLAIMS_NAMESPACE=https://pizza42.example.com/
